# Chronicles of Eldervale — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ===========================================
# GROQ API (Primary LLM — Free)
# Get from: https://console.groq.com/keys
# ===========================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================================
# AZURE AI SEARCH (Foundry IQ backbone)
# Get from: portal.azure.com > eldervale-rg > your search service
# URL looks like: https://searchservice-xxxx.search.windows.net
# Key: Left sidebar > Keys > Primary admin key
# ===========================================
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your_primary_admin_key_here
AZURE_SEARCH_INDEX=eldervale-lore

# ===========================================
# MICROSOFT FOUNDRY PROJECT (Optional — for hosted agents)
# Get from: ai.azure.com > your project > Settings
# ===========================================
AZURE_FOUNDRY_ENDPOINT=https://your-project.services.ai.azure.com/
AZURE_FOUNDRY_API_KEY=your_foundry_api_key_here

# ===========================================
# GAME SETTINGS
# ===========================================
GAME_TITLE=Chronicles of Eldervale
DEBUG_MODE=false
